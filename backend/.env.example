APP_NAME=Guess the Word API
ENVIRONMENT=development
DEBUG=true

# Database configuration
# MySQL (Async asyncmy): mysql+asyncmy://root:password@localhost:3306/guess_the_word
# MySQL (Async aiomysql alternative): mysql+aiomysql://root:password@localhost:3306/guess_the_word
# SQLite (Async local dev alternative): sqlite+aiosqlite:///./guess_the_word.db
DATABASE_URL=mysql+asyncmy://root:password@localhost:3306/guess_the_word

# JWT Security
JWT_SECRET_KEY=dev-secret-key-change-this-in-production-min-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS & Frontend
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate Limiting
LOGIN_RATE_LIMIT=5/minute
REGISTER_RATE_LIMIT=5/hour
